# Database (override for local dev outside Docker)
DATABASE_URL=postgresql+asyncpg://transitden:transitden@localhost:5432/transitden

# GTFS-RT feed URLs (RTD Denver public feeds)
GTFS_RT_VEHICLE_URL=https://www.rtd-denver.com/files/gtfs-rt/VehiclePosition.pb
GTFS_RT_TRIP_URL=https://www.rtd-denver.com/files/gtfs-rt/TripUpdate.pb

# How often to poll the RTD feeds (seconds)
POLLING_INTERVAL_SECONDS=30

# Comma-separated allowed CORS origins
CORS_ORIGINS=["http://localhost:3000"]

# Carto API key for map tiles (optional — tiles work without it but may be rate-limited)
CARTO_API_KEY=

# ── Denver home games (map status carousel) ─────────────────────────────────
# Polls ESPN's public scoreboard for Avalanche / Nuggets / Rockies / Broncos /
# Rapids / Summit home games. No key required.
SPORTS_ENABLED=true
# How long a finished game keeps its carousel slide before clearing.
SPORTS_POSTGAME_WINDOW_MINUTES=120
# Inside this many minutes of first pitch the slide becomes a countdown.
SPORTS_COUNTDOWN_MINUTES=60

# Password for the unlisted /sim game simulator. LEAVE EMPTY to disable it —
# with no password the simulator's routes 404 and no scripted game can ever
# reach the live map. Set it on staging only.
SPORTS_SIM_PASSWORD=
# Hard ceiling on how long one simulation may run before expiring back to ESPN.
SPORTS_SIM_MAX_MINUTES=240
