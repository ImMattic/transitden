# Copy to deployment/.env on the Prod VM. These are the ONLY vars
# docker-compose.prod.yml reads via ${...} — everything else (GTFS URLs,
# polling interval, CORS, sports vars) is hardcoded in the compose file
# itself, not sourced from here. See ../.env.example instead for those,
# if you're running the backend outside Docker.

# Required — compose refuses to start without it.
DB_PASSWORD=

# Required — becomes CORS_ORIGINS and SITE_URL in the compose file.
PROD_DOMAIN=

# This VM's LAN IP. Restricts the frontend's published port 3000 to the
# Caddy VM only. Defaults to 0.0.0.0 (world-reachable on this VM's NIC) if
# left blank — set it.
FRONTEND_BIND_IP=

# Optional — map tiles work without it but may be rate-limited.
CARTO_API_KEY=

# Do NOT add SPORTS_SIM_PASSWORD here. It's intentionally not wired into
# docker-compose.prod.yml at all — the /sim simulator must never exist on
# the production map. Staging only.
